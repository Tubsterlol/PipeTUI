Screen {
    layout: vertical;
}

Header {
    height: 3;
}

Footer {
    height: 1;
}

#main {
    height: 1fr;
}

#left {
    width: 30%;
    min-width: 24;
}

#right {
    width: 70%;
    min-width: 40;
}

.panel {
    border: solid $accent;
    margin: 0 1 1 0;
}

.panel-title {
    height: 1;
    background: $panel;
    color: $text;
    text-style: bold;
    padding-left: 1;
}

#projects-panel {
    height: 2fr;
}

#builds-panel {
    height: 1fr;
}

#pipelines-panel {
    height: 2fr;
    margin-right: 0;
}

#bottom-panels {
    height: 1fr;
    min-height: 8;
}

#details-panel,
#activity-panel {
    width: 1fr;
}

#activity-panel {
    margin-right: 0;
}

#projects,
#pipelines,
#builds {
    height: 1fr;
}

#projects > .data-row,
#pipelines > .data-row,
#builds > .data-row {
    padding: 0 1;
}

#projects > ListItem.-highlight,
#pipelines > ListItem.-highlight,
#builds > ListItem.-highlight {
    background: $accent;
    color: $text;
}

#builds > ListItem.success {
    color: $success;
}

#builds > ListItem.failed {
    color: $error;
}

#details,
#activity {
    padding: 1;
}

#activity {
    height: 1fr;
    overflow-y: auto;
}

#details {
    height: 1fr;
    overflow-y: auto;
}

ListView:focus {
    border: solid $accent;
}
